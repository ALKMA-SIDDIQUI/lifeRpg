# LIFE RPG Environment Configuration
PORT=5000

# ------------------------------------------------------------------------------
# SUPABASE DATABASE CONNECTION (Recommended)
# Go to your Supabase Project -> Settings -> Database -> Connection string
# ------------------------------------------------------------------------------
# Option A: Supabase Connection Pooler (Recommended for IPv4 / Transaction mode):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Option B: Supabase Direct Connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Set DATABASE_SSL=true for Supabase:
# DATABASE_SSL=true
# ------------------------------------------------------------------------------

# Local PostgreSQL Fallback:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/liferpg
DATABASE_SSL=false

JWT_SECRET=life_rpg_super_secret_cyber_jwt_key_2026_dev
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
